# Copy to backend/.env and adjust. Everything here is optional.

# Where the API listens. Keep 127.0.0.1 on a laptop; on the server put it
# behind a reverse proxy with authentication before using 0.0.0.0.
HOST=127.0.0.1
PORT=8000
RELOAD=false

# The password of the Admin panel (admin.html): which agent skills are on, and
# the memories. Without it the Admin panel stays closed. Use a long one.
# ADMIN_PASSWORD=

# Comma-separated origins allowed to call the API. Only needed when the
# frontend is served from somewhere other than this backend.
CORS_ORIGINS=

# Overrides the default Ollama host from ollama/config/models.yaml.
# OLLAMA_HOST=http://127.0.0.1:11434

# Folder with index.html. Defaults to ../frontend.
# FRONTEND_DIR=

# Folder with models.yaml and themes.yaml. Defaults to ../ollama/config.local
# when that exists, otherwise ../ollama/config.
# OLLAMA_PIPELINE_CONFIG=

# Where the Von router's weights (~3 GB) are downloaded. Defaults to the
# Hugging Face cache in your home folder.
# HF_HOME=
